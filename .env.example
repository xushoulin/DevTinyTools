# Copy to `.env.local` for local development, or set these in the Vercel project
# settings for production. Both values are read at build time.
#
# Neither variable is required for a Vercel deployment:
#
# - The canonical origin is pinned in code (PRODUCTION_SITE_URL in
#   src/lib/site.ts, currently https://www.shoulin.shop). Set
#   NEXT_PUBLIC_SITE_URL only to override it for a branch or a staging deploy.
# - The contact address can instead be set in code via CONTACT_EMAIL_FALLBACK
#   in src/lib/site.ts, which avoids the dashboard entirely.
#
# With nothing configured the contact page states that no address has been
# published yet. Nothing is invented.

# Public origin of the site. Used for canonical URLs, Open Graph tags,
# robots.txt and sitemap.xml. Optional: the pinned domain is used when this is
# empty, and a localhost value is ignored in a production build.
NEXT_PUBLIC_SITE_URL=

# Optional. When set, /contact publishes a mailto: link with this address.
#
# The key must be exactly NEXT_PUBLIC_CONTACT_EMAIL: ASCII letters, digits and
# underscores only. A trailing space, a full-width colon or a smart quote pasted
# from a chat message makes the dashboard reject the name. Values that do not
# look like an email address are ignored rather than rendered into a broken
# mailto: link.
NEXT_PUBLIC_CONTACT_EMAIL=
